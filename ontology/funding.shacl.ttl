@prefix ec: <https://id.exergism.org/commons#> .
@prefix ecg: <https://id.exergism.org/governance#> .
@prefix ecf: <https://id.exergism.org/funding#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL defines repository/funding-record validity. Shared institutional
# semantics (decisions, decision classes, votes and conflicts) are referenced
# from Governance rather than redefined in the Funding namespace.

ecf:CanonicalRecordIdentityConstraint a sh:SPARQLConstraint ;
    sh:message "Canonical funding-record IRIs must equal https://id.exergism.org/funding/id/{stableId}." ;
    sh:select """
        PREFIX ec: <https://id.exergism.org/commons#>
        SELECT $this WHERE {
          $this ec:stableId ?id .
          FILTER (STR($this) != CONCAT("https://id.exergism.org/funding/id/", STR(?id)))
        }
    """ .

# Funding owns these record specializations. Governance owns the generic
# GovernanceRecord/GovernanceDecision roots.
ecf:GovernanceRecordShape a sh:NodeShape ;
    sh:targetClass ecf:FundingOpportunity,
                   ecf:FundingAcceptanceDecision,
                   ecf:CompensationDecision,
                   ecf:EndowmentPrincipalWithdrawalDecision,
                   ecf:DiversificationPlan,
                   ecf:InstitutionalFundingState ;
    sh:property [
        sh:path ec:stableId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^ECF-[A-Z0-9-]+$"
    ] ;
    sh:property [
        sh:path ec:provenance ;
        sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1
    ] ;
    sh:xone (
        [ sh:class ecf:FundingOpportunity ]
        [ sh:class ecf:FundingAcceptanceDecision ]
        [ sh:class ecf:CompensationDecision ]
        [ sh:class ecf:EndowmentPrincipalWithdrawalDecision ]
        [ sh:class ecf:DiversificationPlan ]
        [ sh:class ecf:InstitutionalFundingState ]
    ) ;
    sh:sparql ecf:CanonicalRecordIdentityConstraint .

ecf:GovernanceDecisionShape a sh:NodeShape ;
    sh:targetClass ecf:FundingAcceptanceDecision,
                   ecf:CompensationDecision,
                   ecf:EndowmentPrincipalWithdrawalDecision ;
    sh:property [ sh:path ec:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [
        sh:path ec:status ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "proposed" "approved" "rejected" "superseded" )
    ] ;
    sh:property [ sh:path ecg:decisionDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ec:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [
        sh:path ecg:decisionClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:in ( ecg:OrdinaryApproval ecg:QualifiedApproval ecg:EmergencyAction )
    ] .

# Every present EIV score is constrained to [0,1]. If rankEligible=true, all
# ten dimensions become mandatory. Missing values are never defaulted.
ecf:FundingOpportunityShape a sh:NodeShape ;
    sh:targetClass ecf:FundingOpportunity ;
    sh:property [ sh:path ec:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ecf:rankEligible ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path ecf:fit ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:fundingValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:capabilityValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:strategicOptionality ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:autonomyValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:networkValue ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:recurrence ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:captureRisk ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:adminCost ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:executionRisk ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:or (
        [ sh:property [ sh:path ecf:rankEligible ; sh:hasValue false ] ]
        [
          sh:property [ sh:path ecf:rankEligible ; sh:hasValue true ] ;
          sh:property [ sh:path ecf:fit ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:fundingValue ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:capabilityValue ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:strategicOptionality ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:autonomyValue ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:networkValue ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:recurrence ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:captureRisk ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:adminCost ; sh:minCount 1 ] ;
          sh:property [ sh:path ecf:executionRisk ; sh:minCount 1 ]
        ]
    ) .

ecf:DiversificationPlanShape a sh:NodeShape ;
    sh:targetClass ecf:DiversificationPlan ;
    sh:property [ sh:path ec:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ec:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# Institutional maturity and dependency are separate axes, but each state
# individual represents exactly one concrete state.
ecf:InstitutionalFundingStateShape a sh:NodeShape ;
    sh:targetClass ecf:InstitutionalFundingState ;
    sh:property [ sh:path ec:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ec:rationale ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ec:reviewDue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:xone (
        [ sh:class ecf:BootstrapState ]
        [ sh:class ecf:NormalState ]
        [ sh:class ecf:DiversifiedState ]
        [ sh:class ecf:ElevatedConcentrationState ]
        [ sh:class ecf:StrategicDependencyState ]
    ) .

ecf:FundingAcceptanceDecisionShape a sh:NodeShape ;
    sh:targetClass ecf:FundingAcceptanceDecision ;
    sh:property [ sh:path ecf:opportunity ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ecf:FundingOpportunity ] ;
    sh:property [ sh:path ecf:amount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ecf:currency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] ;
    sh:property [ sh:path ecf:restricted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path ecf:singleFunderConcentrationAfter ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path ecf:institutionalPhase ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ecf:FundingPhaseState ] ;
    sh:property [ sh:path ecf:dependencyState ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ecf:FundingDependencyState ] ;
    sh:xone (
        [ sh:property [ sh:path ecf:institutionalPhase ; sh:class ecf:BootstrapState ] ]
        [ sh:property [ sh:path ecf:institutionalPhase ; sh:class ecf:NormalState ] ]
    ) ;
    sh:xone (
        [ sh:property [ sh:path ecf:dependencyState ; sh:class ecf:DiversifiedState ] ]
        [ sh:property [ sh:path ecf:dependencyState ; sh:class ecf:ElevatedConcentrationState ] ]
        [ sh:property [ sh:path ecf:dependencyState ; sh:class ecf:StrategicDependencyState ] ]
    ) ;
    sh:property [ sh:path ecf:governanceRightGranted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
    sh:property [ sh:path ecf:ecWideIpOwnershipGranted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
    sh:property [ sh:path ecf:exclusiveCoreInfrastructureRightGranted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Funding above 30% rolling concentration requires an explicit DiversificationPlan." ;
        sh:select """
            PREFIX ec: <https://id.exergism.org/commons#>
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:singleFunderConcentrationAfter ?c .
              FILTER (?c > 0.30)
              FILTER NOT EXISTS {
                $this ecf:diversificationPlan ?plan .
                ?plan a ecf:DiversificationPlan ; ec:stableId ?planId .
              }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Funding above 50% rolling concentration is strategic dependency and requires qualified approval." ;
        sh:select """
            PREFIX ecg: <https://id.exergism.org/governance#>
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:singleFunderConcentrationAfter ?c ; ecg:decisionClass ?approval .
              FILTER (?c > 0.50 && ?approval != ecg:QualifiedApproval)
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Concentration at or below 30% must be represented by a DiversifiedState." ;
        sh:select """
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:singleFunderConcentrationAfter ?c ; ecf:dependencyState ?state .
              FILTER (?c <= 0.30)
              FILTER NOT EXISTS { ?state a ecf:DiversifiedState }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Concentration above 30% and at or below 50% must be represented by an ElevatedConcentrationState." ;
        sh:select """
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:singleFunderConcentrationAfter ?c ; ecf:dependencyState ?state .
              FILTER (?c > 0.30 && ?c <= 0.50)
              FILTER NOT EXISTS { ?state a ecf:ElevatedConcentrationState }
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Concentration above 50% must be explicitly represented by a StrategicDependencyState." ;
        sh:select """
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:singleFunderConcentrationAfter ?c ; ecf:dependencyState ?state .
              FILTER (?c > 0.50)
              FILTER NOT EXISTS { ?state a ecf:StrategicDependencyState }
            }
        """
    ] .

ecf:CompensationDecisionShape a sh:NodeShape ;
    sh:targetClass ecf:CompensationDecision ;
    sh:property [ sh:path ecf:beneficiary ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class ec:Person ] ;
    sh:property [ sh:path ecf:workBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path ecf:compensationAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path ecf:currency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] ;
    sh:property [ sh:path ecg:hasConflictDeclaration ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class ecg:ConflictDeclaration ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A compensation beneficiary may not cast a substantive vote on their own compensation decision; their vote must be abstain or absent." ;
        sh:select """
            PREFIX ecg: <https://id.exergism.org/governance#>
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this ?vote WHERE {
              $this ecf:beneficiary ?beneficiary ; ecg:hasVote ?vote .
              ?vote ecg:voter ?beneficiary ; ecg:voteValue ?value .
              FILTER (?value != "abstain")
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The compensation beneficiary must be explicitly named as an interested party in a linked conflict declaration." ;
        sh:select """
            PREFIX ecg: <https://id.exergism.org/governance#>
            PREFIX ecf: <https://id.exergism.org/funding#>
            SELECT $this WHERE {
              $this ecf:beneficiary ?beneficiary .
              FILTER NOT EXISTS {
                $this ecg:hasConflictDeclaration ?disclosure .
                ?disclosure ecg:interestedParty ?beneficiary .
              }
            }
        """
    ] .

ecf:EndowmentPrincipalWithdrawalDecisionShape a sh:NodeShape ;
    sh:targetClass ecf:EndowmentPrincipalWithdrawalDecision ;
    sh:property [ sh:path ecf:principalWithdrawalAmount ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minExclusive 0 ] ;
    sh:property [ sh:path ecf:currency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ] ;
    sh:property [ sh:path ecf:exceptionalCondition ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue true ] ;
    sh:property [ sh:path ecg:decisionClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue ecg:QualifiedApproval ] ;
    sh:property [ sh:path ecf:endowmentPurpose ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .
